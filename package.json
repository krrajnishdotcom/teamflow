{
  "name": "teamflow-collaboration-tool",
  "version": "1.0.0",
  "description": "Team Collaboration Tool - Prompt Wars Chennai Hackathon. Built with Google Cloud Run, Firebase, and Vertex AI.",
  "main": "server.js",
  "repository": {
